index=botsv1 earliest=0 latest=now sourcetype=XmlWinEventLog host=we1149srv "3791.exe" "<EventID>1</EventID>"
| rex "<Data Name='UtcTime'>(?<UTC>[^<]+)"
| rex "<Data Name='ProcessId'>(?<PID>[^<]+)"
| rex "<Data Name='Image'>(?<Image>[^<]+)"
| rex "<Data Name='ParentProcessId'>(?<ParentPID>[^<]+)"
| rex "<Data Name='ParentImage'>(?<ParentImage>[^<]+)"
| rex "<EventRecordID>(?<RecordID>[^<]+)"
| sort 0 UTC RecordID
| table UTC RecordID PID ParentPID Image ParentImage